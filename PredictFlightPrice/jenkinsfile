pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                // Clone the Git repository from the main branch
                git branch: 'main', url: 'https://github.com/mamoor2019/ProductionazationOfMLSystem.git'
            }
        }

        stage('Build') {
            steps {
                // Install dependencies and run unit tests
                script {
                    dir('PredictFlightPrice') {
                        if (isUnix()) {
                            sh 'python3 -m pip install -r requirements.txt pytest'
                            sh 'python3 -m pytest'
                        } else {
                            bat 'python -m pip install -r requirements.txt pytest'
                            bat 'python -m pytest'
                        }
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                // Build Docker image
                script {
                    dir('PredictFlightPrice') {
                        def dockerAvailable
                        if (isUnix()) {
                            dockerAvailable = sh(script: 'docker version >/dev/null 2>&1', returnStatus: true) == 0
                        } else {
                            dockerAvailable = bat(script: 'docker version >nul 2>&1', returnStatus: true) == 0
                        }
                        if (!dockerAvailable) {
                            echo 'Docker not available or daemon not running; skipping Docker Build.'
                        } else {
                            if (isUnix()) {
                                sh 'docker build -t mamoor/flight-price-pred .'
                            } else {
                                bat 'docker build -t mamoor/flight-price-pred .'
                            }
                        }
                    }
                }
            }
        }

        stage('Docker Push') {
            steps {
                // Push Docker image to DockerHub
                withCredentials([string(credentialsId: 'dockerhub-credentials', variable: 'DOCKERHUB_PASSWORD')]) {
                    script {
                        dir('PredictFlightPrice') {
                            def dockerAvailable
                            if (isUnix()) {
                                dockerAvailable = sh(script: 'docker version >/dev/null 2>&1', returnStatus: true) == 0
                            } else {
                                dockerAvailable = bat(script: 'docker version >nul 2>&1', returnStatus: true) == 0
                            }
                            if (!dockerAvailable) {
                                echo 'Docker not available or daemon not running; skipping Docker Push.'
                            } else {
                                if (isUnix()) {
                                    sh 'docker login -u yourusername -p $DOCKERHUB_PASSWORD'
                                    sh 'docker push mamoor/flight-price-pred'
                                } else {
                                    bat 'docker login -u yourusername -p %DOCKERHUB_PASSWORD%'
                                    bat 'docker push mamoor/flight-price-pred'
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                // Deploy to Kubernetes or any server
                script {
                    dir('PredictFlightPrice') {
                        def kubectlAvailable
                        if (isUnix()) {
                            kubectlAvailable = sh(script: 'kubectl version --client >/dev/null 2>&1', returnStatus: true) == 0
                        } else {
                            kubectlAvailable = bat(script: 'kubectl version --client >nul 2>&1', returnStatus: true) == 0
                        }
                        if (!kubectlAvailable) {
                            echo 'kubectl not available; skipping Deploy.'
                        } else {
                            if (isUnix()) {
                                sh 'kubectl apply -f deployment.yml'
                            } else {
                                bat 'kubectl apply -f deployment.yml'
                            }
                        }
                    }
                }
            }
        }
    }
    
    post {
        always {
            echo 'Pipeline completed'
        }
    }
}
