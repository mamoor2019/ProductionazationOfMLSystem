pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                // Clone the Git repository from the main branch
                git branch: 'main', url: 'https://github.com/mamoor2019/ProductionazationOfMLSystem.git'
            }
        }

        stage('Build') {
            steps {
                // Install dependencies and run unit tests
                script {
                    dir('PredictFlightPrice') {
                        if (isUnix()) {
                            sh 'python3 -m pip install -r requirements.txt pytest'
                            sh 'python3 -m pytest'
                        } else {
                            bat 'python -m pip install -r requirements.txt pytest'
                            bat 'python -m pytest'
                        }
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                // Build Docker image
                script {
                    dir('PredictFlightPrice') {
                        if (isUnix()) {
                            sh 'docker build -t mamoor/flight-price-pred .'
                        } else {
                            bat 'docker build -t mamoor/flight-price-pred .'
                        }
                    }
                }
            }
        }

        stage('Docker Push') {
            steps {
                // Push Docker image to DockerHub
                withCredentials([string(credentialsId: 'dockerhub-credentials', variable: 'DOCKERHUB_PASSWORD')]) {
                    script {
                        dir('PredictFlightPrice') {
                            if (isUnix()) {
                                sh 'docker login -u yourusername -p $DOCKERHUB_PASSWORD'
                                sh 'docker push mamoor/flight-price-pred'
                            } else {
                                bat 'docker login -u yourusername -p %DOCKERHUB_PASSWORD%'
                                bat 'docker push mamoor/flight-price-pred'
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                // Deploy to Kubernetes or any server
                script {
                    dir('PredictFlightPrice') {
                        if (isUnix()) {
                            sh 'kubectl apply -f deployment.yml'
                        } else {
                            bat 'kubectl apply -f deployment.yml'
                        }
                    }
                }
            }
        }
    }
    
    post {
        always {
            echo 'Pipeline completed'
        }
    }
}
